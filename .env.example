# Set as a protected server runtime secret, never in browser source:
OPENAI_API_KEY=
# Optional model with image + structured output support:
OPENAI_MODEL=gpt-4.1-mini
# Optional application contact sent in the Open Food Facts User-Agent:
OFF_CONTACT_EMAIL=
# Optional: configure a Cloudflare NUTRITION_RATE_LIMITER binding in deployment.
# A binding is NOT an environment string; see docs/nutrition-integration.md.
